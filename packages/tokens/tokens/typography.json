{
  "font": {
    "$description": "Type. The scale owns line height (two values: tight for headings, normal for text) so no style is left at a font-metric default.",
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "system-ui", "sans-serif"], "$description": "Body and UI." },
      "display": {
        "$value": ["Space Grotesk", "Inter", "system-ui", "sans-serif"],
        "$description": "Headings — the 'bold' in bold & vibrant."
      },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "12px" },
      "s": { "$value": "14px" },
      "m": { "$value": "16px" },
      "l": { "$value": "20px" },
      "xl": { "$value": "24px" },
      "2xl": { "$value": "32px" },
      "3xl": { "$value": "40px" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.2 },
      "normal": { "$value": 1.5 }
    }
  }
}
